<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/">

    <!-- 装备槽位模板 -->
    <Button name="AscensionSlotTemplate" virtual="true">
        <Size x="32" y="32"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentBackground">
                    <Size x="32" y="32"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                    <Color r="0.1" g="0.1" b="0.1" a="0.8"/>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <Texture name="$parentBorder" file="Interface\Buttons\UI-Quickslot2">
                    <Size x="46" y="46"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture name="$parentIcon" file="Interface\PaperDoll\UI-Backpack-EmptySlot">
                    <Size x="30" y="30"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture name="$parentLock" file="Interface\Icons\INV_Misc_QuestionMark">
                    <Size x="20" y="20"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                    <Color r="1" g="0.2" b="0.2" a="1"/>
                </Texture>
            </Layer>
        </Layers>
        <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
        <Scripts>
            <OnEnter>AscensionSlot_OnEnter(self)</OnEnter>
            <OnLeave>AscensionSlot_OnLeave(self)</OnLeave>
            <OnClick>AscensionSlot_OnClick(self, button)</OnClick>
            <OnDoubleClick>AscensionSlot_OnDoubleClick(self, button)</OnDoubleClick>
            <OnDragStart>AscensionSlot_OnDragStart(self)</OnDragStart>
            <OnReceiveDrag>AscensionSlot_OnReceiveDrag(self)</OnReceiveDrag>
        </Scripts>
    </Button>

    <!-- 飞升系统主框架 - 与官方角色面板大小一致 -->
    <Frame name="AscensionMainFrame" parent="UIParent" toplevel="true" movable="true" enableMouse="true" hidden="true">
        <Size x="338" y="424"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>

        <!-- 背景 -->
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Gold-Border" tile="true">
            <BackgroundInsets>
                <AbsInset left="11" right="12" top="12" bottom="11"/>
            </BackgroundInsets>
            <TileSize>
                <AbsValue val="32"/>
            </TileSize>
            <EdgeSize>
                <AbsValue val="32"/>
            </EdgeSize>
        </Backdrop>

        <Layers>
            <!-- 标题 -->
            <Layer level="ARTWORK">
                <FontString name="AscensionMainFrameTitle" inherits="GameFontNormal" text="飞升装备">
                    <Anchors>
                        <Anchor point="TOP" relativeTo="AscensionMainFrame" relativePoint="TOP" x="0" y="-15"/>
                    </Anchors>
                    <Color r="1.0" g="0.84" b="0"/>
                </FontString>
            </Layer>
        </Layers>

        <Frames>
            <!-- 关闭按钮 -->
            <Button name="AscensionMainFrameCloseButton" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeTo="AscensionMainFrame" relativePoint="TOPRIGHT" x="-3" y="-3"/>
                </Anchors>
            </Button>

            <!-- 角色模型区域 -->
            <PlayerModel name="AscensionCharacterModel" parent="AscensionMainFrame">
                <Size x="140" y="180"/>
                <Anchors>
                    <Anchor point="CENTER" relativeTo="AscensionMainFrame" relativePoint="CENTER" x="0" y="20"/>
                </Anchors>
            </PlayerModel>

            <!-- 左侧槽位 0-7 (头部到脚部) -->
            <Button name="AscensionSlot0" inherits="AscensionSlotTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="AscensionMainFrame" relativePoint="TOPLEFT" x="12" y="-35"/>
                </Anchors>
            </Button>
            <Button name="AscensionSlot1" inherits="AscensionSlotTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="AscensionSlot0" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
                </Anchors>
            </Button>
            <Button name="AscensionSlot2" inherits="AscensionSlotTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="AscensionSlot1" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
                </Anchors>
            </Button>
            <Button name="AscensionSlot3" inherits="AscensionSlotTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="AscensionSlot2" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
                </Anchors>
            </Button>
            <Button name="AscensionSlot4" inherits="AscensionSlotTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="AscensionSlot3" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
                </Anchors>
            </Button>
            <Button name="AscensionSlot5" inherits="AscensionSlotTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="AscensionSlot4" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
                </Anchors>
            </Button>
            <Button name="AscensionSlot6" inherits="AscensionSlotTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="AscensionSlot5" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
                </Anchors>
            </Button>
            <Button name="AscensionSlot7" inherits="AscensionSlotTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="AscensionSlot6" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
                </Anchors>
            </Button>

            <!-- 右侧槽位 8-14 (手腕到披风) -->
            <Button name="AscensionSlot8" inherits="AscensionSlotTemplate">
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeTo="AscensionMainFrame" relativePoint="TOPRIGHT" x="-12" y="-35"/>
                </Anchors>
            </Button>
            <Button name="AscensionSlot9" inherits="AscensionSlotTemplate">
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeTo="AscensionSlot8" relativePoint="BOTTOMRIGHT" x="0" y="-4"/>
                </Anchors>
            </Button>
            <Button name="AscensionSlot10" inherits="AscensionSlotTemplate">
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeTo="AscensionSlot9" relativePoint="BOTTOMRIGHT" x="0" y="-4"/>
                </Anchors>
            </Button>
            <Button name="AscensionSlot11" inherits="AscensionSlotTemplate">
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeTo="AscensionSlot10" relativePoint="BOTTOMRIGHT" x="0" y="-4"/>
                </Anchors>
            </Button>
            <Button name="AscensionSlot12" inherits="AscensionSlotTemplate">
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeTo="AscensionSlot11" relativePoint="BOTTOMRIGHT" x="0" y="-4"/>
                </Anchors>
            </Button>
            <Button name="AscensionSlot13" inherits="AscensionSlotTemplate">
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeTo="AscensionSlot12" relativePoint="BOTTOMRIGHT" x="0" y="-4"/>
                </Anchors>
            </Button>
            <Button name="AscensionSlot14" inherits="AscensionSlotTemplate">
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeTo="AscensionSlot13" relativePoint="BOTTOMRIGHT" x="0" y="-4"/>
                </Anchors>
            </Button>

            <!-- 底部槽位 15-17 (主手、副手、远程) -->
            <Button name="AscensionSlot15" inherits="AscensionSlotTemplate">
                <Anchors>
                    <Anchor point="BOTTOM" relativeTo="AscensionMainFrame" relativePoint="BOTTOM" x="-40" y="45"/>
                </Anchors>
            </Button>
            <Button name="AscensionSlot16" inherits="AscensionSlotTemplate">
                <Anchors>
                    <Anchor point="BOTTOM" relativeTo="AscensionMainFrame" relativePoint="BOTTOM" x="0" y="45"/>
                </Anchors>
            </Button>
            <Button name="AscensionSlot17" inherits="AscensionSlotTemplate">
                <Anchors>
                    <Anchor point="BOTTOM" relativeTo="AscensionMainFrame" relativePoint="BOTTOM" x="40" y="45"/>
                </Anchors>
            </Button>
        </Frames>

        <Scripts>
            <OnLoad>AscensionUI_OnLoad(self)</OnLoad>
            <OnShow>AscensionUI_OnShow()</OnShow>
            <OnHide>AscensionUI_OnHide()</OnHide>
            <OnDragStart>self:StartMoving()</OnDragStart>
            <OnDragStop>self:StopMovingOrSizing()</OnDragStop>
            <OnEvent>AscensionUI_OnEvent(self, event, ...)</OnEvent>
        </Scripts>
    </Frame>

    <!-- 快捷按钮 -->
    <Button name="AscensionQuickButton" parent="UIParent" movable="true" enableMouse="true" hidden="true">
        <Size x="36" y="36"/>
        <Anchors>
            <Anchor point="BOTTOMRIGHT" relativeTo="UIParent" relativePoint="BOTTOMRIGHT" x="-220" y="80"/>
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="AscensionQuickButtonBackground">
                    <Size x="36" y="36"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                    <Color r="0.2" g="0.2" b="0.3" a="0.9"/>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture name="AscensionQuickButtonIcon" file="Interface\Icons\INV_Misc_Gem_Variety_02">
                    <Size x="28" y="28"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
        <Scripts>
            <OnLoad>AscensionQuickButton_OnLoad(self)</OnLoad>
            <OnClick>AscensionUI_Toggle()</OnClick>
            <OnDragStart>self:StartMoving()</OnDragStart>
            <OnDragStop>self:StopMovingOrSizing(); AscensionUI_SaveQuickButtonPosition()</OnDragStop>
            <OnEnter>GameTooltip:SetOwner(self, "ANCHOR_TOP"); GameTooltip:SetText("飞升装备系统", 1, 0.84, 0); GameTooltip:AddLine("点击打开飞升装备界面", 1, 1, 1); GameTooltip:Show()</OnEnter>
            <OnLeave>GameTooltip:Hide()</OnLeave>
        </Scripts>
    </Button>

</Ui>

