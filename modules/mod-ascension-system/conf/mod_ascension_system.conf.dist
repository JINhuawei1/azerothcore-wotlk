[worldserver]

###################################################################################################
#  飞升系统配置
###################################################################################################

#
#    飞升系统.启用
#        描述: 是否启用飞升系统
#        默认: 1 (启用)
#

飞升系统.启用 = 1

#
#    飞升系统.调试模式
#        描述: 是否启用调试模式，输出详细日志
#        默认: 0 (禁用)
#

飞升系统.调试模式 = 0

#
#    飞升系统.属性倍率
#        描述: 全局属性倍率，影响所有飞升装备的属性加成
#        默认: 1.0
#

飞升系统.属性倍率 = 1.0

#
#    飞升系统.需要等级
#        描述: 使用飞升系统所需的最低等级
#        默认: 1
#

飞升系统.需要等级 = 1

#
#    飞升系统.显示提示
#        描述: 是否在装备/卸下时显示提示消息
#        默认: 1 (启用)
#

飞升系统.显示提示 = 1

#
#    飞升系统.自动解锁
#        描述: 是否自动解锁所有槽位（忽略解锁需求）
#        默认: 0 (禁用，需要满足解锁条件)
#

飞升系统.自动解锁 = 0
