[worldserver]

###################################################################################################
#  物品鉴定系统模块
###################################################################################################

# 启用物品鉴定系统
# 默认: 1 (启用)
# 设置为0禁用
ItemIdentificationSystem.Enable = 1

# 鉴定成功率基础值（百分比）
# 默认: 100 (100%)
ItemIdentificationSystem.BaseSuccessRate = 100

# 鉴定失败是否销毁物品
# 默认: 0 (不销毁)
# 设置为1启用销毁
ItemIdentificationSystem.DestroyOnFail = 0

# 鉴定需要消耗的金币（铜币单位）
# 默认: 10000 (1金币)
ItemIdentificationSystem.Cost = 10000

# 是否启用公告系统
# 默认: 1 (启用)
# 设置为0禁用
ItemIdentificationSystem.EnableAnnounce = 1

# 调试模式
# 默认: 0 (禁用)
# 设置为1启用
ItemIdentificationSystem.Debug = 0
