<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Frame name="AbyssCultivationUIFrame" parent="UIParent" movable="true" enableMouse="true" hidden="true" toplevel="true" frameStrata="DIALOG">
        <Size>
            <AbsDimension x="1180" y="700"/>
        </Size>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Frames>
            <Button name="$parentCloseButton" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-2" y="-2"/>
                </Anchors>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad>
                self:RegisterForDrag("LeftButton");
                self:SetClampedToScreen(true);
                table.insert(UISpecialFrames, self:GetName());
                AbyssCultivationUI:OnLoad(self);
            </OnLoad>
            <OnShow>
                AbyssCultivationUI:UpdateIconButtonVisibility();
            </OnShow>
            <OnHide>
                AbyssCultivationUI:UpdateIconButtonVisibility();
            </OnHide>
            <OnDragStart>
                self:StartMoving();
            </OnDragStart>
            <OnDragStop>
                self:StopMovingOrSizing();
                self:SetUserPlaced(false);
            </OnDragStop>
        </Scripts>
    </Frame>
</Ui>
