<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!-- ============================================================ -->
    <!-- 暗黑金按钮模板                                                -->
    <!-- ============================================================ -->
    <Button name="PromoDarkGoldButtonTemplate" virtual="true">
        <Size x="120" y="28"/>
        <Backdrop bgFile="Interface\ChatFrame\ChatFrameBackground" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="false">
            <BackgroundInsets>
                <AbsInset left="3" right="3" top="3" bottom="3"/>
            </BackgroundInsets>
            <EdgeSize>
                <AbsValue val="12"/>
            </EdgeSize>
            <Color r="0.08" g="0.06" b="0.03" a="0.95"/>
            <BorderColor r="0.70" g="0.54" b="0.20" a="1.0"/>
        </Backdrop>

        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentHighlight" file="Interface\ChatFrame\ChatFrameBackground" alphaMode="ADD" hidden="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="3" y="-3"/>
                        <Anchor point="BOTTOMRIGHT" x="-3" y="3"/>
                    </Anchors>
                    <Color r="0.95" g="0.72" b="0.22" a="0.14"/>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString name="$parentText" inherits="GameFontNormal" justifyH="CENTER">
                    <Anchors>
                        <Anchor point="CENTER" x="0" y="0"/>
                    </Anchors>
                    <Color r="1.0" g="0.84" b="0.10"/>
                </FontString>
            </Layer>
        </Layers>

        <Scripts>
            <OnEnter>
                this:SetBackdropColor(0.20, 0.15, 0.06, 1.0)
                this:SetBackdropBorderColor(1.0, 0.85, 0.10, 1.0)
                local hl = getglobal(this:GetName() .. "Highlight")
                if hl then hl:Show() end
                local text = getglobal(this:GetName() .. "Text")
                if text then text:SetTextColor(1.0, 1.0, 0.90) end
            </OnEnter>
            <OnLeave>
                this:SetBackdropColor(0.08, 0.06, 0.03, 0.95)
                this:SetBackdropBorderColor(0.70, 0.54, 0.20, 1.0)
                local hl = getglobal(this:GetName() .. "Highlight")
                if hl then hl:Hide() end
                local text = getglobal(this:GetName() .. "Text")
                if text then text:SetTextColor(1.0, 0.84, 0.10) end
            </OnLeave>
            <OnMouseDown>
                this:SetBackdropColor(0.04, 0.03, 0.01, 1.0)
                local text = getglobal(this:GetName() .. "Text")
                if text then text:SetPoint("CENTER", 1, -1) end
            </OnMouseDown>
            <OnMouseUp>
                this:SetBackdropColor(0.18, 0.14, 0.06, 1.0)
                local text = getglobal(this:GetName() .. "Text")
                if text then text:SetPoint("CENTER", 0, 0) end
            </OnMouseUp>
        </Scripts>
    </Button>

    <!-- ============================================================ -->
    <!-- AI 素材按钮模板 (所有底部按钮统一用它)                        -->
    <!-- ============================================================ -->
    <Button name="PromoAIButtonTemplate" virtual="true">
        <Size x="120" y="28"/>

        <NormalTexture file="Interface\AddOns\PromotionReward\Assets\button_bg.tga">
            <Anchors>
                <Anchor point="TOPLEFT"/>
                <Anchor point="BOTTOMRIGHT"/>
            </Anchors>
        </NormalTexture>
        <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>

        <Layers>
            <Layer level="OVERLAY">
                <FontString name="$parentText" inherits="GameFontNormal" justifyH="CENTER">
                    <Anchors>
                        <Anchor point="CENTER" x="0" y="0"/>
                    </Anchors>
                    <Color r="1.0" g="0.88" b="0.22"/>
                </FontString>
            </Layer>
        </Layers>

        <Scripts>
            <OnEnter>
                local tex = this:GetNormalTexture()
                if tex then tex:SetVertexColor(1.25, 1.25, 1.1) end
                local t = getglobal(this:GetName() .. "Text")
                if t then t:SetTextColor(1.0, 1.0, 0.95) end
            </OnEnter>
            <OnLeave>
                local tex = this:GetNormalTexture()
                if tex then tex:SetVertexColor(1.0, 1.0, 1.0) end
                local t = getglobal(this:GetName() .. "Text")
                if t then t:SetTextColor(1.0, 0.88, 0.22) end
            </OnLeave>
            <OnMouseDown>
                local tex = this:GetNormalTexture()
                if tex then tex:SetVertexColor(0.70, 0.70, 0.70) end
                local t = getglobal(this:GetName() .. "Text")
                if t then t:SetPoint("CENTER", 1, -1) end
            </OnMouseDown>
            <OnMouseUp>
                local tex = this:GetNormalTexture()
                if tex then tex:SetVertexColor(1.0, 1.0, 1.0) end
                local t = getglobal(this:GetName() .. "Text")
                if t then t:SetPoint("CENTER", 0, 0) end
            </OnMouseUp>
        </Scripts>
    </Button>

