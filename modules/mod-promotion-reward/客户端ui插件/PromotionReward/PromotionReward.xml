                    </Button>

                    <Button name="$parentCloseButton" inherits="PromoDarkGoldButtonTemplate">
                        <Size x="80" y="26"/>
                        <Anchors>
                            <Anchor point="RIGHT" x="-14" y="0"/>
                        </Anchors>
                        <Scripts>
                            <OnLoad>
                                getglobal(this:GetName() .. "Text"):SetText("关 闭")
                            </OnLoad>
                            <OnClick>
                                PromotionRewardUI:Hide()
                            </OnClick>
                        </Scripts>
                    </Button>
                </Frames>
            </Frame>
        </Frames>

        <Scripts>
            <OnLoad>
                PromotionRewardUI:OnLoad()
            </OnLoad>
            <OnShow>
                PromotionRewardUI:OnShow()
            </OnShow>
            <OnDragStart>
                this:StartMoving()
            </OnDragStart>
            <OnDragStop>
                this:StopMovingOrSizing()
                PromotionRewardUI:SavePosition()
            </OnDragStop>
        </Scripts>
    </Frame>

    <!-- ============================================================ -->
    <!-- 屏幕顶部图标按钮 (金色底盘)                                  -->
    <!-- ============================================================ -->
    <Frame name="PromotionRewardIconFrame" parent="UIParent" movable="true" enableMouse="false">
        <Size x="60" y="46"/>
        <Anchors>
            <Anchor point="TOP" x="-120" y="-10"/>
        </Anchors>

        <Frames>
            <Button name="$parentIconButton" enableMouse="true" movable="true">
                <Size x="26" y="26"/>
                <Anchors>
                    <Anchor point="TOP" x="0" y="-2"/>
                </Anchors>

                <Backdrop bgFile="Interface\ChatFrame\ChatFrameBackground" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="false">
                    <BackgroundInsets>
                        <AbsInset left="3" right="3" top="3" bottom="3"/>
                    </BackgroundInsets>
                    <EdgeSize>
                        <AbsValue val="12"/>
                    </EdgeSize>
                    <Color r="0.05" g="0.04" b="0.02" a="0.85"/>
                    <BorderColor r="0.65" g="0.50" b="0.20" a="1.0"/>
                </Backdrop>

                <NormalTexture file="Interface\Icons\INV_Misc_Coin_17">
                    <Size x="18" y="18"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                    <TexCoord left="0.07" right="0.93" top="0.07" bottom="0.93"/>
                </NormalTexture>
                <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>

                <Scripts>
                    <OnClick>
                        PromotionRewardUI:Toggle()
                    </OnClick>
                    <OnEnter>
                        this:SetBackdropBorderColor(1.0, 0.82, 0.0, 1.0)
                        GameTooltip:SetOwner(this, "ANCHOR_RIGHT")
                        GameTooltip:SetText("宣传奖励", 1, 0.82, 0)
                        GameTooltip:AddLine("点击打开宣传奖励界面", 0.8, 0.8, 0.8, true)
                        GameTooltip:AddLine("拖动可移动图标位置", 0.6, 0.6, 0.6, true)
                        if PromotionRewardUI and PromotionRewardUI.state and PromotionRewardUI.state.days > 0 then
                            GameTooltip:AddLine(" ")
                            GameTooltip:AddLine("累计宣传: " .. PromotionRewardUI.state.days .. " 天", 1, 0.85, 0.30)
                            GameTooltip:AddLine("武器加成: +" .. PromotionRewardUI.state.totalAttr, 0.85, 0.55, 1.0)
                        end
                        GameTooltip:Show()
                    </OnEnter>
                    <OnLeave>
                        this:SetBackdropBorderColor(0.65, 0.50, 0.20, 1.0)
                        GameTooltip:Hide()
                    </OnLeave>
                    <OnDragStart>
                        this:GetParent():StartMoving()
                    </OnDragStart>
                    <OnDragStop>
                        this:GetParent():StopMovingOrSizing()
                        PromotionRewardUI:SaveIconPosition()
                    </OnDragStop>
                </Scripts>
            </Button>
        </Frames>

        <Layers>
            <Layer level="OVERLAY">
                <FontString name="$parentText" inherits="GameFontNormalSmall" text="宣传奖励">
                    <Anchors>
                        <Anchor point="TOP" x="0" y="-28"/>
                    </Anchors>
                    <Color r="1.0" g="0.82" b="0.0"/>
                </FontString>
            </Layer>
        </Layers>

        <Scripts>
            <OnLoad>
                PromotionRewardUI:InitializeIconButton()
            </OnLoad>
        </Scripts>
    </Frame>

</Ui>
