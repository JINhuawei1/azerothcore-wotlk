                        <Texture name="$parentIcon" file="Interface\Icons\INV_Inscription_Tradeskill01">
                            <Size x="18" y="18"/>
                            <Anchors>
                                <Anchor point="LEFT" x="8" y="0"/>
                            </Anchors>
                            <TexCoord left="0.07" right="0.93" top="0.07" bottom="0.93"/>
                        </Texture>

                        <FontString name="$parentLabel" inherits="GameFontNormal" text="CDK兑换">
                            <Anchors>
                                <Anchor point="LEFT" relativeTo="$parentIcon" relativePoint="RIGHT" x="6" y="0"/>
                            </Anchors>
                            <Color r="0.88" g="0.80" b="0.56"/>
                        </FontString>
                    </Layer>
                </Layers>

                <Frames>
                    <EditBox name="$parentCodeInput" autoFocus="false" letters="32">
                        <Size x="248" y="26"/>
                        <Anchors>
                            <Anchor point="LEFT" relativeTo="$parentLabel" relativePoint="RIGHT" x="8" y="0"/>
                        </Anchors>

                        <Backdrop bgFile="Interface\ChatFrame\ChatFrameBackground" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="false">
                            <BackgroundInsets>
                                <AbsInset left="3" right="3" top="3" bottom="3"/>
                            </BackgroundInsets>
                            <EdgeSize>
                                <AbsValue val="12"/>
                            </EdgeSize>
                            <Color r="0.05" g="0.04" b="0.02" a="1.0"/>
                            <BorderColor r="0.70" g="0.52" b="0.22" a="1.0"/>
                        </Backdrop>

                        <FontString inherits="ChatFontNormal"/>

                        <Scripts>
                            <OnEnterPressed>
                                PromotionRewardUI:RedeemFromInput()
                            </OnEnterPressed>
                            <OnEscapePressed>
                                this:ClearFocus()
                            </OnEscapePressed>
                            <OnEditFocusGained>
                                this:SetBackdropBorderColor(1.0, 0.86, 0.14, 1.0)
                            </OnEditFocusGained>
                            <OnEditFocusLost>
                                this:SetBackdropBorderColor(0.70, 0.52, 0.22, 1.0)
                            </OnEditFocusLost>
                        </Scripts>
                    </EditBox>

                    <Button name="$parentRedeemButton" inherits="PromoAIButtonTemplate">
                        <Size x="120" y="30"/>
                        <Anchors>
                            <Anchor point="LEFT" relativeTo="$parentCodeInput" relativePoint="RIGHT" x="10" y="0"/>
                        </Anchors>
                        <Scripts>
                            <OnLoad>
                                getglobal(this:GetName() .. "Text"):SetText("兑  换")
                            </OnLoad>
                            <OnClick>
                                PromotionRewardUI:RedeemFromInput()
                            </OnClick>
                        </Scripts>
                    </Button>
                </Frames>
            </Frame>

            <!-- ─── AI 生成华丽金色分隔线 ─── -->
            <Frame name="$parentDividerBottom">
                <Size x="320" y="40"/>
                <Anchors>
                    <Anchor point="TOP" x="0" y="-412"/>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture name="$parentTex" file="Interface\AddOns\PromotionReward\Assets\divider_ornate.tga">
                            <Anchors>
                                <Anchor point="TOPLEFT"/>
                                <Anchor point="BOTTOMRIGHT"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Frame>

            <!-- ============================================================ -->
            <!-- 底部按钮区                                                    -->
            <!-- ============================================================ -->
            <Frame name="$parentButtonPanel">
                <Size x="480" y="36"/>
                <Anchors>
                    <Anchor point="BOTTOM" x="0" y="12"/>
                </Anchors>

                <Layers>
                    <Layer level="ARTWORK">
                        <FontString name="$parentStatus" inherits="GameFontDisable" text="" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="LEFT" x="14" y="0"/>
                                <Anchor point="RIGHT" x="-210" y="0"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>

                <Frames>
                    <Button name="$parentRefreshButton" inherits="PromoAIButtonTemplate">
                        <Size x="120" y="30"/>
                        <Anchors>
                            <Anchor point="RIGHT" x="-130" y="0"/>
                        </Anchors>
                        <Scripts>
                            <OnLoad>
                                getglobal(this:GetName() .. "Text"):SetText("刷  新")
                            </OnLoad>
                            <OnClick>
                                PromotionRewardUI:RequestRefresh()
                            </OnClick>
                        </Scripts>
                    </Button>

                    <Button name="$parentCloseButton" inherits="PromoAIButtonTemplate">
                        <Size x="120" y="30"/>
                        <Anchors>
                            <Anchor point="RIGHT" x="-14" y="0"/>
                        </Anchors>
                        <Scripts>
                            <OnLoad>
                                getglobal(this:GetName() .. "Text"):SetText("关  闭")
                            </OnLoad>
                            <OnClick>
                                PromotionRewardUI:Hide()
                            </OnClick>
                        </Scripts>
                    </Button>
                </Frames>
            </Frame>
        </Frames>

        <Scripts>
            <OnLoad>
                PromotionRewardUI:OnLoad()
            </OnLoad>
            <OnShow>
                PromotionRewardUI:OnShow()
            </OnShow>
            <OnDragStart>
                this:StartMoving()
            </OnDragStart>
            <OnDragStop>
                this:StopMovingOrSizing()
                PromotionRewardUI:SavePosition()
            </OnDragStop>
        </Scripts>
    </Frame>

    <!-- ============================================================ -->
    <!-- 屏幕顶部图标按钮 (金色底盘)                                   -->
    <!-- ============================================================ -->
    <Frame name="PromotionRewardIconFrame" parent="UIParent" movable="true" enableMouse="false">
        <Size x="60" y="40"/>
        <Anchors>
            <Anchor point="TOP" x="-120" y="-10"/>
        </Anchors>

        <Frames>
            <Button name="$parentIconButton" enableMouse="true" movable="true">
                <Size x="20" y="20"/>
                <Anchors>
                    <Anchor point="TOP" x="0" y="-2"/>
                </Anchors>

                <NormalTexture file="Interface\AddOns\PromotionReward\Assets\icon_button.tga">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                </NormalTexture>
                <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>

                <Scripts>
                    <OnClick>
                        PromotionRewardUI:Toggle()
                    </OnClick>
                    <OnEnter>
                        local tex = this:GetNormalTexture()
                        if tex then tex:SetVertexColor(1.0, 1.0, 0.85) end
                        GameTooltip:SetOwner(this, "ANCHOR_RIGHT")
                        GameTooltip:SetText("宣传神器", 1, 0.86, 0.12)
                        GameTooltip:AddLine("点击打开宣传奖励界面", 0.84, 0.84, 0.84, true)
                        GameTooltip:AddLine("拖动可移动图标位置", 0.6, 0.6, 0.6, true)
                        if PromotionRewardUI and PromotionRewardUI.state and PromotionRewardUI.state.days > 0 then
                            GameTooltip:AddLine(" ")
                            GameTooltip:AddLine("累计宣传: " .. PromotionRewardUI.state.days .. " 天", 1, 0.88, 0.32)
                            GameTooltip:AddLine("神器加成: +" .. PromotionRewardUI.state.totalAttr, 0.90, 0.60, 1.0)
                        end
                        GameTooltip:Show()
                    </OnEnter>
                    <OnLeave>
                        local tex = this:GetNormalTexture()
                        if tex then tex:SetVertexColor(1.0, 1.0, 1.0) end
                        GameTooltip:Hide()
                    </OnLeave>
                    <OnDragStart>
                        this:GetParent():StartMoving()
                    </OnDragStart>
                    <OnDragStop>
                        this:GetParent():StopMovingOrSizing()
                        PromotionRewardUI:SaveIconPosition()
                    </OnDragStop>
                </Scripts>
            </Button>
        </Frames>

        <Layers>
            <Layer level="OVERLAY">
                <FontString name="$parentText" inherits="GameFontNormalSmall" text="宣传神器">
                    <Anchors>
                        <Anchor point="TOP" x="0" y="-24"/>
                    </Anchors>
                    <Color r="1.0" g="0.86" b="0.14"/>
                </FontString>
            </Layer>
        </Layers>

        <Scripts>
            <OnLoad>
                PromotionRewardUI:InitializeIconButton()
            </OnLoad>
        </Scripts>
    </Frame>

</Ui>
