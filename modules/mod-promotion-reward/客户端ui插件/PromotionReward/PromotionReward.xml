                    </Anchors>
                    <Color r="1.0" g="0.90" b="0.55"/>
                </FontString>
            </Layer>
        </Layers>

        <Frames>
            <Button name="$parentBtn" inherits="PromoDarkGoldButtonTemplate">
                <Size x="62" y="22"/>
                <Anchors>
                    <Anchor point="RIGHT" x="-6" y="0"/>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        getglobal(this:GetName() .. "Text"):SetText("兑 换")
                    </OnLoad>
                </Scripts>
            </Button>
        </Frames>

        <Scripts>
            <OnEnter>
                this:SetBackdropColor(0.32, 0.24, 0.09, 0.90)
                local tag = getglobal(this:GetName() .. "Tag")
                if tag then tag:SetVertexColor(1.0, 0.90, 0.40, 1.0) end
                local code = getglobal(this:GetName() .. "Code")
                if code then code:SetTextColor(1.0, 1.0, 0.70) end
            </OnEnter>
            <OnLeave>
                local odd = this.isOdd
                if odd then
                    this:SetBackdropColor(0.12, 0.08, 0.04, 0.55)
                else
                    this:SetBackdropColor(0.08, 0.05, 0.02, 0.55)
                end
                local tag = getglobal(this:GetName() .. "Tag")
                if tag then tag:SetVertexColor(0.90, 0.72, 0.30, 1.0) end
                local code = getglobal(this:GetName() .. "Code")
                if code then code:SetTextColor(1.0, 0.90, 0.55) end
            </OnLeave>
        </Scripts>
    </Frame>

