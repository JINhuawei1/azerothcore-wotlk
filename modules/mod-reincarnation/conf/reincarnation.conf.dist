#
# 转身系统配置文件
#

###################################################################################################
#
# 转身系统设置
#
#    Reincarnation.Enable
#        描述: 启用转身系统
#        默认: 1 - 启用
#                0 - 禁用
#

Reincarnation.Enable = 1

#
#    Reincarnation.Debug
#        描述: 启用调试模式，输出详细日志
#        默认: 0 - 禁用
#                1 - 启用
#

Reincarnation.Debug = 0

###################################################################################################
