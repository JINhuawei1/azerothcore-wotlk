<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <!-- 主窗口框架 -->
    <Frame name="ReincarnationMainFrame" parent="UIParent" frameStrata="HIGH" movable="true" enableMouse="true" hidden="true">
        <Size x="400" y="480"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>

        <!-- 暗黑背景 -->
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background-Dark" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
            <BackgroundInsets>
                <AbsInset left="11" right="12" top="12" bottom="11"/>
            </BackgroundInsets>
            <TileSize>
                <AbsValue val="32"/>
            </TileSize>
            <EdgeSize>
                <AbsValue val="32"/>
            </EdgeSize>
        </Backdrop>

        <Layers>
            <!-- 标题背景 -->
            <Layer level="ARTWORK">
                <Texture name="$parentTitleBg">
                    <Size x="380" y="30"/>
                    <Anchors>
                        <Anchor point="TOP" relativeTo="$parent" relativePoint="TOP">
                            <Offset x="0" y="-10"/>
                        </Anchor>
                    </Anchors>
                    <Color r="0.1" g="0.05" b="0.15" a="0.9"/>
                </Texture>

                <!-- 标题文字 -->
                <FontString name="$parentTitleText" inherits="GameFontNormalLarge" text="转身系统">
                    <Anchors>
                        <Anchor point="TOP" relativeTo="$parent" relativePoint="TOP">
                            <Offset x="0" y="-15"/>
                        </Anchor>
                    </Anchors>
                    <Color r="0.6" g="0.2" b="1" a="1"/>
                </FontString>
            </Layer>
        </Layers>

        <Frames>
            <!-- 关闭按钮 -->
            <Button name="$parentCloseButton" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeTo="$parent" relativePoint="TOPRIGHT">
                        <Offset x="-5" y="-5"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        ReincarnationMainFrame:Hide()
                    </OnClick>
                </Scripts>
            </Button>

            <!-- 基础信息面板 -->
            <Frame name="$parentInfoFrame">
                <Size x="370" y="100"/>
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parent" relativePoint="TOP">
                        <Offset x="0" y="-45"/>
                    </Anchor>
                </Anchors>
                <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
                    <BackgroundInsets>
                        <AbsInset left="3" right="3" top="3" bottom="3"/>
                    </BackgroundInsets>
                    <TileSize>
                        <AbsValue val="16"/>
                    </TileSize>
                    <EdgeSize>
                        <AbsValue val="16"/>
                    </EdgeSize>
                </Backdrop>
                <Scripts>
                    <OnLoad>
                        self:SetBackdropColor(0.08, 0.08, 0.12, 0.95)
                        self:SetBackdropBorderColor(0.3, 0.3, 0.4, 1)
                    </OnLoad>
                </Scripts>

                <Layers>
                    <Layer level="OVERLAY">
                        <!-- 转身图标 -->
                        <Texture name="$parentIcon" file="Interface\Icons\Spell_Holy_Resurrection">
                            <Size x="50" y="50"/>
                            <Anchors>
                                <Anchor point="TOPLEFT">
                                    <Offset x="10" y="-10"/>
                                </Anchor>
                            </Anchors>
                            <TexCoords left="0.07" right="0.93" top="0.07" bottom="0.93"/>
                        </Texture>

                        <!-- 转身等级 -->
                        <FontString name="$parentLevelLabel" inherits="GameFontNormal" text="转身等级:">
                            <Anchors>
                                <Anchor point="TOPLEFT" relativeTo="$parentIcon" relativePoint="TOPRIGHT">
                                    <Offset x="10" y="-5"/>
                                </Anchor>
                            </Anchors>
                            <Color r="0.8" g="0.8" b="0.8"/>
                        </FontString>

                        <FontString name="$parentLevelText" inherits="GameFontNormalLarge" text="|cff666666未转身|r">
                            <Anchors>
                                <Anchor point="LEFT" relativeTo="$parentLevelLabel" relativePoint="RIGHT">
                                    <Offset x="5" y="0"/>
                                </Anchor>
                            </Anchors>
                        </FontString>

                        <!-- 玩家等级 -->
                        <FontString name="$parentPlayerLevelText" inherits="GameFontNormalSmall" text="角色等级: 1">
                            <Anchors>
                                <Anchor point="TOPRIGHT">
                                    <Offset x="-10" y="-10"/>
                                </Anchor>
                            </Anchors>
                            <Color r="0.7" g="0.7" b="0.7"/>
                        </FontString>

                        <!-- 全属性加成 -->
                        <FontString name="$parentStatsLabel" inherits="GameFontNormal" text="全属性加成:">
                            <Anchors>
                                <Anchor point="TOPLEFT" relativeTo="$parentIcon" relativePoint="TOPRIGHT">
                                    <Offset x="10" y="-25"/>
                                </Anchor>
                            </Anchors>
                            <Color r="0.8" g="0.8" b="0.8"/>
                        </FontString>

                        <FontString name="$parentStatsText" inherits="GameFontNormalLarge" text="|cff666666无加成|r">
                            <Anchors>
                                <Anchor point="LEFT" relativeTo="$parentStatsLabel" relativePoint="RIGHT">
                                    <Offset x="5" y="0"/>
                                </Anchor>
                            </Anchors>
                        </FontString>

                        <!-- 额外天赋点 -->
                        <FontString name="$parentTalentLabel" inherits="GameFontNormal" text="额外天赋点:">
                            <Anchors>
                                <Anchor point="TOPLEFT" relativeTo="$parentIcon" relativePoint="TOPRIGHT">
                                    <Offset x="10" y="-45"/>
                                </Anchor>
                            </Anchors>
                            <Color r="0.8" g="0.8" b="0.8"/>
                        </FontString>

                        <FontString name="$parentTalentText" inherits="GameFontNormalLarge" text="|cff666666无|r">
                            <Anchors>
                                <Anchor point="LEFT" relativeTo="$parentTalentLabel" relativePoint="RIGHT">
                                    <Offset x="5" y="0"/>
                                </Anchor>
                            </Anchors>
                        </FontString>

                        <!-- 下一转预览 -->
                        <FontString name="$parentNextLevelLabel" inherits="GameFontNormalSmall" text="下一转: +5% 全属性, +5 天赋点">
                            <Anchors>
                                <Anchor point="BOTTOMLEFT">
                                    <Offset x="10" y="8"/>
                                </Anchor>
                            </Anchors>
                            <Color r="0.6" g="0.6" b="0.6"/>
                        </FontString>

                        <FontString name="$parentNextLevelText" inherits="GameFontNormalSmall" text="">
                            <Anchors>
                                <Anchor point="LEFT" relativeTo="$parentNextLevelLabel" relativePoint="RIGHT">
                                    <Offset x="5" y="0"/>
                                </Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>

                <Scripts>
                    <OnLoad>
                        self:SetBackdropColor(0.08, 0.08, 0.12, 0.95)
                        self:SetBackdropBorderColor(0.3, 0.3, 0.4, 1)
                        self.LevelText = _G[self:GetName().."LevelText"]
                        self.StatsText = _G[self:GetName().."StatsText"]
                        self.TalentText = _G[self:GetName().."TalentText"]
                        self.PlayerLevelText = _G[self:GetName().."PlayerLevelText"]
                        self.NextLevelText = _G[self:GetName().."NextLevelLabel"]
                    </OnLoad>
                </Scripts>
            </Frame>

            <!-- 属性加成详情面板 -->
            <Frame name="$parentAttributeFrame">
                <Size x="370" y="260"/>
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentInfoFrame" relativePoint="BOTTOM">
                        <Offset x="0" y="-8"/>
                    </Anchor>
                </Anchors>
                <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
                    <BackgroundInsets>
                        <AbsInset left="3" right="3" top="3" bottom="3"/>
                    </BackgroundInsets>
                    <TileSize>
                        <AbsValue val="16"/>
                    </TileSize>
                    <EdgeSize>
                        <AbsValue val="16"/>
                    </EdgeSize>
                </Backdrop>

                <Layers>
                    <Layer level="OVERLAY">
                        <FontString name="$parentTitle" inherits="GameFontNormal" text="全属性加成详情">
                            <Anchors>
                                <Anchor point="TOP">
                                    <Offset x="0" y="-8"/>
                                </Anchor>
                            </Anchors>
                            <Color r="0.7" g="0.4" b="1"/>
                        </FontString>
                    </Layer>
                </Layers>

                <Scripts>
                    <OnLoad>
                        self:SetBackdropColor(0.08, 0.08, 0.12, 0.95)
                        self:SetBackdropBorderColor(0.3, 0.3, 0.4, 1)
                        -- 全属性列表
                        local attrs = {
                            {name="力量", color="|cffC69B6D"},
                            {name="敏捷", color="|cff00FF00"},
                            {name="耐力", color="|cffFF7D0A"},
                            {name="智力", color="|cff69CCF0"},
                            {name="精神", color="|cffFFFFFF"},
                            {name="生命值", color="|cff00FF00"},
                            {name="法力值", color="|cff0080FF"},
                            {name="攻击强度", color="|cffFF4444"},
                            {name="远程攻强", color="|cffFF8800"},
                            {name="法术强度", color="|cffFF00FF"},
                            {name="护甲值", color="|cffFFFF00"},
                            {name="防御等级", color="|cff8888FF"},
                            {name="躲闪等级", color="|cff88FF88"},
                            {name="招架等级", color="|cffFF8888"},
                            {name="格挡等级", color="|cffFFFF88"},
                            {name="命中等级", color="|cffFFAA00"},
                            {name="暴击等级", color="|cffFF0000"},
                            {name="急速等级", color="|cff00FFFF"},
                            {name="精准等级", color="|cffAAAAFF"},
                            {name="护甲穿透", color="|cffFFCC00"},
                        }
                        local cols = 2
                        local colWidth = 170
                        local rowHeight = 18
                        local startY = -28
                        local startX = 15
                        for i, attr in ipairs(attrs) do
                            local col = (i - 1) % cols
                            local row = math.floor((i - 1) / cols)
                            local row_frame = CreateFrame("Frame", self:GetName().."AttrRow"..i, self)
                            row_frame:SetSize(colWidth, rowHeight)
                            row_frame:SetPoint("TOPLEFT", self, "TOPLEFT", startX + col * colWidth, startY - row * rowHeight)
                            row_frame.NameText = row_frame:CreateFontString(nil, "OVERLAY", "GameFontNormalSmall")
                            row_frame.NameText:SetPoint("LEFT", row_frame, "LEFT", 0, 0)
                            row_frame.NameText:SetText(attr.color..attr.name.."|r")
                            row_frame.ValueText = row_frame:CreateFontString(nil, "OVERLAY", "GameFontNormalSmall")
                            row_frame.ValueText:SetPoint("RIGHT", row_frame, "RIGHT", -10, 0)
                            row_frame.ValueText:SetText("|cff666666+0%|r")
                            self["AttrRow"..i] = row_frame
                        end
                    </OnLoad>
                </Scripts>
            </Frame>

            <!-- 金色转身按钮 -->
            <Button name="$parentReincarnateButton" text="转身升级">
                <Size x="140" y="30"/>
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentAttributeFrame" relativePoint="BOTTOM">
                        <Offset x="0" y="-8"/>
                    </Anchor>
                </Anchors>
                <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
                    <BackgroundInsets>
                        <AbsInset left="4" right="4" top="4" bottom="4"/>
                    </BackgroundInsets>
                    <TileSize>
                        <AbsValue val="16"/>
                    </TileSize>
                    <EdgeSize>
                        <AbsValue val="16"/>
                    </EdgeSize>
                </Backdrop>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString name="$parentText" inherits="GameFontNormal" text="转身升级">
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                            <Color r="1" g="0.84" b="0"/>
                        </FontString>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnLoad>
                        self:SetBackdropColor(0.4, 0.3, 0.1, 0.95)
                        self:SetBackdropBorderColor(1, 0.84, 0, 1)
                    </OnLoad>
                    <OnClick>
                        ReincarnationUI_ShowConfirm()
                    </OnClick>
                    <OnEnter>
                        self:SetBackdropColor(0.6, 0.45, 0.15, 0.95)
                        self:SetBackdropBorderColor(1, 0.9, 0.3, 1)
                        GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
                        if ReincarnationData and ReincarnationData:CanReincarnate() then
                            GameTooltip:AddLine("点击进行转身", 0, 1, 0)
                            GameTooltip:AddLine("转身后等级将重置为1级", 1, 0.5, 0)
                        else
                            GameTooltip:AddLine("需要达到80级才能转身", 1, 0, 0)
                        end
                        GameTooltip:Show()
                    </OnEnter>
                    <OnLeave>
                        self:SetBackdropColor(0.4, 0.3, 0.1, 0.95)
                        self:SetBackdropBorderColor(1, 0.84, 0, 1)
                        GameTooltip:Hide()
                    </OnLeave>
                </Scripts>
            </Button>


            <!-- 底部提示 -->
            <Frame name="$parentFooter">
                <Size x="370" y="20"/>
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentReincarnateButton" relativePoint="BOTTOM">
                        <Offset x="0" y="-5"/>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString name="$parentTip" inherits="GameFontNormalSmall" text="转身后等级重置为1级，获得永久属性加成">
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                            <Color r="1" g="0.84" b="0"/>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>

        <Scripts>
            <OnLoad>
                ReincarnationUI_OnLoad(self)
            </OnLoad>
            <OnShow>
                ReincarnationUI_OnShow(self)
            </OnShow>
            <OnHide>
                ReincarnationUI_OnHide(self)
            </OnHide>
            <OnDragStart>
                self:StartMoving()
            </OnDragStart>
            <OnDragStop>
                self:StopMovingOrSizing()
            </OnDragStop>
        </Scripts>
    </Frame>

    <!-- 转身确认对话框 -->
    <Frame name="ReincarnationConfirmFrame" parent="UIParent" frameStrata="DIALOG" movable="true" enableMouse="true" hidden="true">
        <Size x="300" y="150"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background-Dark" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
            <BackgroundInsets>
                <AbsInset left="11" right="12" top="12" bottom="11"/>
            </BackgroundInsets>
            <TileSize>
                <AbsValue val="32"/>
            </TileSize>
            <EdgeSize>
                <AbsValue val="32"/>
            </EdgeSize>
        </Backdrop>

        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentTitle" inherits="GameFontNormalLarge" text="确认转身">
                    <Anchors>
                        <Anchor point="TOP">
                            <Offset x="0" y="-20"/>
                        </Anchor>
                    </Anchors>
                    <Color r="1" g="0.3" b="0.3" a="1"/>
                </FontString>

                <FontString name="$parentText" inherits="GameFontNormal" justifyH="CENTER">
                    <Size x="260" y="50"/>
                    <Anchors>
                        <Anchor point="CENTER">
                            <Offset x="0" y="10"/>
                        </Anchor>
                    </Anchors>
                    <Color r="1" g="0.85" b="0.3" a="1"/>
                </FontString>
            </Layer>
        </Layers>

        <Frames>
            <Button name="$parentConfirmButton" inherits="UIPanelButtonTemplate" text="确认">
                <Size x="100" y="25"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT">
                        <Offset x="30" y="20"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        ReincarnationUI_DoReincarnate()
                    </OnClick>
                </Scripts>
            </Button>

            <Button name="$parentCancelButton" inherits="UIPanelButtonTemplate" text="取消">
                <Size x="100" y="25"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT">
                        <Offset x="-30" y="20"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        ReincarnationConfirmFrame:Hide()
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>

        <Scripts>
            <OnShow>
                ReincarnationConfirmFrameText:SetText("确定要进行转身吗？\n|cffFF0000转身后等级将重置为1级！|r")
            </OnShow>
        </Scripts>
    </Frame>

</Ui>
